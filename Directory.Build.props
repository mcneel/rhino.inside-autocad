<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
		<TargetFrameworkName>net48</TargetFrameworkName>
		<RuntimeName>NET48</RuntimeName>
	</PropertyGroup>

	<!--
		Serves AutoCAD/Civil 3D 2025 and 2026 on BOTH runtimes. Autodesk moved those
		releases from .NET 8 to .NET 10 without changing their series numbers (2025 stays
		R25.0, 2026 stays R25.1), and RuntimeRequirements in PackageContents.xml can only
		discriminate on series - so this leg must load under either, which it does by
		.NET roll-forward. It cannot be retired while un-updated installs remain.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'DebugNET8' Or '$(Configuration)' == 'ReleaseNET8'">
		<TargetFrameworkName>net8.0-windows</TargetFrameworkName>
		<RuntimeName>NET8</RuntimeName>
	</PropertyGroup>

	<!-- AutoCAD/Civil 3D 2027 (R26.0) only; its managed SDK targets net10.0. -->
	<PropertyGroup Condition="'$(Configuration)' == 'DebugNET10' Or '$(Configuration)' == 'ReleaseNET10'">
		<TargetFrameworkName>net10.0-windows</TargetFrameworkName>
		<RuntimeName>NET10</RuntimeName>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyVersion>1.3.2</AssemblyVersion>
		<AppFolderName>Rhino.Inside.AutoCAD.bundle</AppFolderName>

		<AppRootDir>$(APPDATA)\Autodesk\ApplicationPlugins\$(AppFolderName)\</AppRootDir>
		<AppRootResources>$(AppRootDir)Resources\</AppRootResources>
		<AppRootDirVersioned>$(AppRootDir)$(AssemblyVersion)\</AppRootDirVersioned>
		<AppRootDirAssemblies>$(AppRootDirVersioned)Win64\$(RuntimeName)\</AppRootDirAssemblies>

		<AppRootUserTests>$(APPDATA)\Bimorph\Tests\</AppRootUserTests>
		<AppRootUserSupportedApplication>$(APPDATA)\Bimorph\SupportedApplications\</AppRootUserSupportedApplication>

		<DeploymentPackage>$(ProjDir)..\..\Deployment\OutputFiles\Rhino.Inside.AutoCAD.$(AssemblyVersion)\</DeploymentPackage>
		<DeploymentPackageVersioned>$(DeploymentPackage)$(AssemblyVersion)\</DeploymentPackageVersioned>
		<DeploymentPackage_Win64>$(DeploymentPackageVersioned)Win64\$(RuntimeName)\</DeploymentPackage_Win64>

		<BimorphCompany>Bimorph Digital Engineering LTD</BimorphCompany>
		<BimorphProduct>Rhino.Inside.AutoCAD</BimorphProduct>
		<BimorphCopyright>Copyright © Bimorph LTD. 2026</BimorphCopyright>
		<CompanyName>Bimorph Digital Engineering LTD</CompanyName>
		<AppName>Rhino.Inside.AutoCAD</AppName>
	</PropertyGroup>
</Project>
